{
  "name": "depthdesk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace frontend -- --outDir ../dist/client --emptyOutDir && node scripts/bundle-worker.mjs",
    "test": "npm test --workspace backend",
    "start": "node backend/scripts/start.mjs --with-frontend"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
